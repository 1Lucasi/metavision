        MODELOS["src/ar/modelos.ts<br/>require dos 23 GLB"]
    end

    subgraph RA["CAMADA DE REALIDADE AUMENTADA"]
        direction TB
        VIRO["ViroReact 2.57.3<br/>ViroARScene, ViroARPlaneSelector,<br/>ViroNode, Viro3DObject"]
